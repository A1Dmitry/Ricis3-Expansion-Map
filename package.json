{
  "name": "ricis3-expansion",
  "private": false,
  "version": "0.4.53",
  "description": "Interactive RICIS-III singularity research map with explicit proof-trust boundaries",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": ">=12.0.2"
  },
  "scripts": {
    "sync:version": "tsx tools/syncVersion.ts",
    "release:check": "npm run sync:version && vitest run tools/releaseConsistency.test.ts",
    "dev": "npm run sync:version && tsx server.ts",
    "generate:node-entries": "tsx tools/generateNodeEntries.ts",
    "build": "npm run release:check && npm run generate:node-entries && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test": "npm run sync:version && vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@react-three/fiber": "^9.7.0",
    "express": "^5.2.1",
    "katex": "^0.18.4",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.41",
    "tailwindcss": "^4.0.0-alpha.20",
    "tsx": "^4.16.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "homepage": "https://a1dmitry.github.io/Ricis3-Expansion-Map/",
  "bugs": {
    "url": "https://github.com/A1Dmitry/Ricis3-Expansion-Map/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A1Dmitry/Ricis3-Expansion-Map.git"
  },
  "keywords": [
    "ricis-iii",
    "formal-verification",
    "lean4",
    "singularity",
    "research-software"
  ]
}
