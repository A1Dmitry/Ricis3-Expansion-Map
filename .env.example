# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: HTTP listen port for `npm run dev` / `npm start` (default 3000).
# Incident 2026-09-17 fact A: a hard-coded 3000 turned leftover processes into
# a silent dead preview (Express 5 listen-callback swallowed EADDRINUSE).
# Set an alternate free port when 3000 is already taken.
PORT="3000"

# RICIS_CORE_DOTNET_PROBE_TIMEOUT_MS: async `dotnet --version` probe ceiling
# (default 2000). Incident 2026-09-17 fact B: the previous spawnSync probe
# blocked the whole event loop for up to 10 s on every /api/ricis-core/* call.
RICIS_CORE_DOTNET_PROBE_TIMEOUT_MS="2000"

# RICIS_CORE_DOTNET_PROBE_COOLDOWN_MS: after a failed host probe, skip re-probing
# for this many ms (default 30000) so a missing/slow dotnet cannot re-freeze
# the interface on every user action.
RICIS_CORE_DOTNET_PROBE_COOLDOWN_MS="30000"

# RICIS_AI_CALL_DEADLINE_MS: hard ceiling for one server-side AI call chain
# (default 45000). Must stay below the client postJson timeout (60000) so the
# server stops burning quota after the browser has already aborted
# (incident 2026-09-17 fact C3).
RICIS_AI_CALL_DEADLINE_MS="45000"

# RICIS_AI_MAX_MODELS: max models tried from the Gemini pool per request (default 4).
RICIS_AI_MAX_MODELS="4"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_RICIS_CORE_API_BASE_URL: Optional public HTTPS base URL of a deployed C# Ricis.Core API.
# Example: https://core.example.org/api/ricis-core
# Leave unset to use the same-origin local Express proxy at /api/ricis-core.
# The remote service must allow CORS from the published Pages origin and expose /health plus /expressions/simplify.
VITE_RICIS_CORE_API_BASE_URL=""

# VITE_ALLOWED_HOSTS: Development host policy of the Vite dev server (`npm run dev`).
# Unset (recommended) → proxied preview hosts are allowed. Sandbox / AI Studio / Cloud Run
#   reach this process only through a reverse proxy, and Vite's host check would otherwise
#   answer `403 Blocked request. This host (…) is not allowed.` before any app code runs —
#   incident 2026-09-16: docs/05-evidence/architecture/incident-2026-09-16-preview-not-displaying.md.
# 'false' → strict: localhost / IP literals only.
# '.e2b.app,proxy.internal' → only these host names/suffixes (leading dot = suffix match).
# Dev-only: `vite build` and `npm start` ignore it, so the published site is never affected.
VITE_ALLOWED_HOSTS=""

# VITE_RICIS_CALCULATOR_BASE_URL: Existing public HTTPS Remix calculator.
# The catalogue appends an allowlisted mode and the static preset state.
VITE_RICIS_CALCULATOR_BASE_URL="https://remix-ricis-iii-501343051156.europe-west2.run.app/"

# ZENODO_API_TOKEN: Optional Zenodo production REST API Personal Access Token.
# Used for depositing verified Lean evidence manifests and acquiring permanent version DOIs.
# Never expose to client-side bundles or public manifests.
ZENODO_API_TOKEN=""

# ZENODO_SANDBOX_TOKEN: Optional Zenodo Sandbox REST API Personal Access Token.
# Used for testing archival depositions in the sandbox environment (https://sandbox.zenodo.org).
ZENODO_SANDBOX_TOKEN=""

# EXTERNAL_LEAN_VERIFIER_URL: Optional external independent Lean verification service endpoint.
# Must execute actual Lean 4 kernel compilation (e.g. Lean 4.33.1) and return raw compiler exit code and stdout.
EXTERNAL_LEAN_VERIFIER_URL=""

# ZENODO_API_BASE_URL: Optional base URL of the Zenodo REST API used by the
# server endpoints /api/zenodo/v1/dumps and /api/zenodo/v1/profile.
# Default: https://zenodo.org (public "List available dumps" API,
# https://developers.zenodo.org/#list-available-dumps). No token is required:
# the integration only reads the public dump directory.
ZENODO_API_BASE_URL=""
